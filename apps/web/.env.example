# URL de la API para el SSR (server de Next → API, red interna en prod).
API_URL=http://localhost:3000/api/v1

# URL de la API para el navegador (fetch desde el cliente y origen del HLS local).
# Debe ser alcanzable desde el browser.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# --- Acceso con Google (opcional) ---
# Client ID de OAuth del proyecto de Google Cloud. Sin él, el botón de Google
# aparece desactivado en lugar de fallar al pulsarlo.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Acceso con WhatsApp (opcional) ---
# 'true' solo cuando la API tenga los endpoints /auth/whatsapp/*. Mientras
# tanto, el botón se muestra como no disponible.
NEXT_PUBLIC_AUTH_WHATSAPP=false
