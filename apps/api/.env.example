# ---- App ----
NODE_ENV=development
PORT=3000

# ---- PostgreSQL (must match docker-compose defaults) ----
# 15432 on the host to avoid clashing with native Postgres installs (5432/5433).
DATABASE_HOST=localhost
DATABASE_PORT=15432
DATABASE_USER=netflix
DATABASE_PASSWORD=netflix
DATABASE_NAME=netflix_clone

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ---- JWT (used from Phase 3; min length 16 enforced by env validation) ----
JWT_ACCESS_SECRET=change_me_dev_access_secret_please
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Media / pipeline de vídeo (Phase 5; todas opcionales con defaults) ----
# Directorios relativos al CWD de la API (apps/api). Se crean al vuelo.
# MEDIA_SOURCE_DIR=storage/source   # vídeos fuente a transcodificar
# MEDIA_OUTPUT_DIR=storage/hls      # salida HLS servida estáticamente
# MEDIA_WORK_DIR=storage/tmp        # dir temporal de trabajo de ffmpeg
# MEDIA_PUBLIC_PATH=/media          # ruta pública que sirve MEDIA_OUTPUT_DIR
# MEDIA_TRANSCODE_CONCURRENCY=1     # jobs de transcodificación en paralelo (1-8)

# ---- Almacenamiento (Phase 6) ----
# driver: 'local' (disco, por defecto) o 'r2' (Cloudflare R2 vía API S3).
STORAGE_DRIVER=local
# Requeridas solo si STORAGE_DRIVER=r2:
# R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=netflix-clone-media
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev   # o tu dominio propio del bucket
# R2_PRESIGN_EXPIRES=900                        # validez de las URLs firmadas (s, 60-3600)
