# ---- App ----
NODE_ENV=development
PORT=3000

# ---- PostgreSQL (must match docker-compose defaults) ----
# 15432 on the host to avoid clashing with native Postgres installs (5432/5433).
DATABASE_HOST=localhost
DATABASE_PORT=15432
DATABASE_USER=netflix
DATABASE_PASSWORD=netflix
DATABASE_NAME=netflix_clone

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ---- JWT (used from Phase 3; min length 16 enforced by env validation) ----
JWT_ACCESS_SECRET=change_me_dev_access_secret_please
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
