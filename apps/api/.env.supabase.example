# Conexión a Supabase Postgres.
#
#   cp .env.supabase.example .env.supabase     (y rellena los huecos)
#
# `.env.supabase` está ignorado por git, así que la contraseña no sale de tu
# máquina. Se carga en el entorno solo para lanzar las migraciones:
#
#   cd apps/api
#   set -a && . ./.env.supabase && set +a && npm run migration:run

# Obligatorio: Supabase rechaza cualquier conexión sin cifrar.
DATABASE_SSL=true

# Del "Session pooler" (NO el de transaction, puerto 6543: rompe las prepared
# statements que usa TypeORM). Tiene esta pinta:
#   aws-0-<region>.pooler.supabase.com
DATABASE_HOST=
DATABASE_PORT=5432

# En el pooler el usuario lleva la referencia del proyecto: postgres.<ref>
DATABASE_USER=
# La contraseña que elegiste al crear el proyecto (NO la clave anon ni la
# service_role: esas son de la API de Supabase, no de Postgres).
DATABASE_PASSWORD=

# En Supabase la base se llama `postgres`, no `netflix_clone`.
DATABASE_NAME=postgres
