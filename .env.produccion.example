# Plantilla de entorno para docker-compose.prod.yml.
#   cp .env.produccion.example .env.produccion
# Está en .gitignore como `.env*`: NO lo commitees una vez relleno.

# ---- Dominios (los dos que expones tras el proxy TLS) ----
# URL pública de la API. Se incrusta en el bundle del navegador AL COMPILAR,
# así que si la cambias hay que reconstruir la imagen del front (--build).
NEXT_PUBLIC_API_URL=https://api.tudominio.com/api/v1

# Orígenes permitidos por CORS, separados por comas. Obligatorio en producción.
# Es el dominio del FRONT, no el de la API.
CORS_ORIGINS=https://tudominio.com

# ---- Puertos que publica el host (el proxy apunta aquí) ----
API_PUERTO=3000
WEB_PUERTO=3001

# ---- PostgreSQL ----
DATABASE_USER=netflix
DATABASE_PASSWORD=cambia_esto_por_algo_largo_y_aleatorio
DATABASE_NAME=netflix_clone
# 'true' si la base es gestionada (Supabase, Neon…): solo aceptan TLS y sin esto
# la conexión ni se llega a abrir. Déjalo en false para el Postgres del compose.
DATABASE_SSL=false

# ---- Redis ----
REDIS_PASSWORD=cambia_esto_tambien

# ---- JWT (mínimo 16 caracteres; genera con: openssl rand -base64 48) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Almacenamiento ----
# local = disco del contenedor (volumen media_data). r2 = Cloudflare R2.
# Para cualquier cosa seria, r2: el disco local no sobrevive a recrear el
# servicio si alguien olvida el volumen, y no escala a más de una réplica.
STORAGE_DRIVER=local

# Solo si STORAGE_DRIVER=r2. El driver habla S3 estándar, así que sirve para
# cualquier proveedor compatible; lo que cambia es el endpoint.
#
#   Cloudflare R2  -> deja S3_ENDPOINT vacío y rellena R2_ACCOUNT_ID.
#   Otro S3        -> pon S3_ENDPOINT y olvida R2_ACCOUNT_ID. Por ejemplo,
#                     Supabase: https://<proyecto>.supabase.co/storage/v1/s3
S3_ENDPOINT=
S3_REGION=auto
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública desde la que se sirve el HLS (dominio del bucket o del CDN).
R2_PUBLIC_BASE_URL=

# Transcodificaciones en paralelo. Cada una satura un núcleo: no lo subas por
# encima de los cores que tenga la máquina o ahogarás a la API.
MEDIA_TRANSCODE_CONCURRENCY=1
